# Copy to .env.local and fill in. Only needed for --provider higgsfield.
# Higgsfield API credentials from console.higgsfield.ai, as key-id:key-secret.
HF_CREDENTIALS=
# Optional: a different image model.
# HF_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
# Optional: TypeSafe key for visual QA (is the product there, whole, with a real label?). Without it the check is skipped, not passed.
TYPESAFE_API_KEY=
